    <string name="lock_subtitle_incorrect">Incorrect PIN, try again</string>
    <string name="lock_subtitle_lockout">Too many attempts. Try again in %1$ds</string>
    <plurals name="lock_subtitle_attempts_left">
        <item quantity="one">Incorrect PIN - %1$d attempt left</item>
