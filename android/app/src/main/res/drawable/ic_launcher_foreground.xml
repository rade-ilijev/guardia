<?xml version="1.0" encoding="utf-8"?>
<!--
    Sentinel mark: a bold shield drawn as one continuous stroke that breaks at the top-right
    into a "scan notch", with a single dot at center — the eye of the guard. One strong
    silhouette that survives 24dp and pure-white monochrome.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bezel ring echoing the in-app status orb, pulled well inside the adaptive safe zone so
         launcher masks never crowd it. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2CF5D8"
        android:strokeAlpha="0.22"
        android:strokeWidth="1.5"
        android:pathData="M54,54m-31.5,0a31.5,31.5 0,1 1,63 0a31.5,31.5 0,1 1,-63 0" />
    <!-- Shield stroke, open at the top-right scan notch. Sized with clear air between the
         stroke, the bezel ring, and the notch gap. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M64.23,37.34 L70.5,40 L70.5,55 C70.5,65.5 63.5,72 54,76 C44.5,72 37.5,65.5 37.5,55 L37.5,40 L54,33 L55.98,33.84"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38"
                android:startY="31"
                android:endX="72"
                android:endY="80"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0" />
                <item android:color="#FF7FF9E4" android:offset="0.45" />
                <item android:color="#FF12B9CF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- The eye of the guard. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,52.5m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0" />
</vector>
