    <!--
        Lock screen and PIN recovery.

        This screen is the localization template for the rest of the app - see LOCALIZATION.md.
        Note the two shapes that are easy to get wrong and are done properly here:

        * `lock_subtitle_attempts_left` is a plural, not a string with an "s" glued on. English has
          two forms; Polish has four and Arabic six, and no amount of string concatenation gets
          those right.
        * Positional arguments (%1$s, %1$d) rather than bare %s, so a translator can reorder them
          when their language puts the number somewhere else in the sentence.
    -->
    <string name="lock_status_secured">SECURED</string>
    <string name="lock_status_denied">ACCESS DENIED</string>
    <string name="lock_status_locked_out">LOCKED OUT</string>
